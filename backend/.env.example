# =====================================================================
# InsightHub Backend - Environment Variables Template
# انسخ هذا الملف إلى .env واملأ القيم الفعلية للتشغيل المحلي
#
# على Hugging Face Spaces، اضبط هذه القيم في:
#   Settings > Variables and secrets
# (لا ترفع ملف .env فعلي إلى الـ Space أو GitHub)
# =====================================================================

# ----- Supabase (إلزامي) -----
# Service Role Key يتجاوز RLS - تجده في:
#   Supabase Dashboard > Settings > API > service_role
SUPABASE_URL=https://mckhttjxpflppzndoavy.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ----- App Settings -----
APP_ENV=development            # development | production
API_HOST=0.0.0.0
API_PORT=8000                  # على HF Spaces يجب أن يكون 7860 (مضبوط في Dockerfile)
LOG_LEVEL=INFO

# ----- Polling -----
# الزمن بين كل فحص لطلبات pending في analysis_requests (ثانية)
# اضبطه على false إذا كنت تستخدم /trigger من الـ Frontend مباشرة
POLL_INTERVAL_SECONDS=30
ENABLE_POLLING=true

# ----- Analysis Limits -----
# حد أقصى للمنشورات بعد الفلترة (للحماية من ذاكرة العامل)
MAX_POSTS_PER_ANALYSIS=10000
# حد أقصى للصفوف المسحوبة قبل الفلترة من كل dataset
MAX_ROWS_PER_DATASET=100000
# الحد الأدنى من النتائج لقبول التحليل
MIN_POSTS_THRESHOLD=20

# ----- PySpark -----
SPARK_APP_NAME=InsightHub
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DEFAULT_PARALLELISM=4

# ----- HuggingFace -----
# اختياري - فقط للـ datasets الخاصة (gated)
# HUGGINGFACE_TOKEN=hf_xxx

# ----- NLP Models -----
# نموذج تحليل المشاعر العربي
SENTIMENT_MODEL=CAMeL-Lab/bert-base-arabic-camelbert-da-sentiment
# جهاز التشغيل: cpu | cuda | mps
NLP_DEVICE=cpu
SENTIMENT_BATCH_SIZE=16

# ----- CORS -----
# مفصولة بفواصل - أضف دومين Netlify الخاص بك
CORS_ORIGINS=https://magnificent-smakager-e0e69f.netlify.app,http://localhost:3000,http://localhost:5173
