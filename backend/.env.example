# =====================================================================
# InsightHub Backend - Environment Variables Template
# انسخ هذا الملف إلى .env واملأ القيم الفعلية
# =====================================================================

# ----- Supabase -----
# استخدم Service Role Key (وليس anon) لتجاوز RLS
# تجده في: Supabase Dashboard > Settings > API > service_role
SUPABASE_URL=https://mckhttjxpflppzndoavy.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ----- Redis (Celery broker) -----
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- App Settings -----
APP_ENV=development            # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ----- Polling -----
# الزمن بين كل فحص لطلبات pending في analysis_requests (ثانية)
POLL_INTERVAL_SECONDS=30
ENABLE_POLLING=true

# ----- Analysis Limits -----
# حد أقصى لعدد المنشورات بعد الفلترة (للحماية من ذاكرة العامل)
MAX_POSTS_PER_ANALYSIS=20000
# حد أقصى لعدد الصفوف المسحوبة قبل الفلترة من كل dataset
MAX_ROWS_PER_DATASET=200000
# الحد الأدنى من النتائج لقبول التحليل
MIN_POSTS_THRESHOLD=20

# ----- PySpark -----
SPARK_APP_NAME=InsightHub
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
# عدد الـ partitions للتوازي
SPARK_DEFAULT_PARALLELISM=4

# ----- HuggingFace -----
# اختياري - فقط للـ datasets الخاصة (gated)
# HUGGINGFACE_TOKEN=hf_xxx

# ----- NLP Models -----
# نموذج تحليل المشاعر العربي (CAMeL-Lab أنسب للعامية)
SENTIMENT_MODEL=CAMeL-Lab/bert-base-arabic-camelbert-da-sentiment
# جهاز التشغيل: cpu | cuda | mps
NLP_DEVICE=cpu
# حجم الدفعة عند التنبؤ
SENTIMENT_BATCH_SIZE=32

# ----- CORS -----
# مفصولة بفواصل
CORS_ORIGINS=https://magnificent-smakager-e0e69f.netlify.app,http://localhost:3000,http://localhost:5173
